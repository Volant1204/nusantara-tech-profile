---
import Layout from '../layouts/Layout.astro';
import { daftarLayanan } from '../data/layanan.js';
import PencarianLayanan from '../components/react/PencarianLayanan.jsx'; // 1. Import komponen React
---

<Layout judulHalaman="Layanan - Nusantara Tech">
  <div class="text-center mb-8">
    <h1 class="text-3xl font-bold text-gray-900 dark:text-white mb-4">Layanan Kami</h1>
    <p class="text-gray-600 dark:text-gray-300">Solusi lengkap untuk kebutuhan digital bisnis Anda.</p>
  </div>
  
  <!-- 2. Panggil Komponen React di sini (jangan lupa client:load) -->
  <PencarianLayanan client:load /> 

  <!-- 3. Grid layanan yang lama -->
  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-8">
    {daftarLayanan.map((layanan) => (
      <div class="bg-gray-50 p-6 rounded-xl border border-gray-200 hover:shadow-xl transition-shadow duration-300 dark:bg-gray-800 dark:border-gray-700">
        <h3 class="text-xl font-bold text-blue-600 mb-3 dark:text-blue-400">{layanan.nama}</h3>
        <p class="text-gray-600 leading-relaxed mb-4 dark:text-gray-300">{layanan.deskripsi}</p>
        <a href={`/layanan/${layanan.id}`} class="text-blue-600 font-semibold hover:underline dark:text-blue-400">
          Selengkapnya &rarr;
        </a>
      </div>
    ))}
  </div>
</Layout>