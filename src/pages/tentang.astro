---
import Layout from '../layouts/Layout.astro';
---

<Layout judulHalaman="Tentang Kami - Nusantara Tech">
  <div class="max-w-3xl mx-auto">
    <h1 class="text-3xl font-bold text-gray-900 mb-6 text-center">Tentang Nusantara Tech</h1>
    <p class="text-lg text-gray-700 leading-relaxed mb-8 text-center">
      Didirikan pada tahun 2026, Nusantara Tech berkomitmen untuk membawa UMKM dan perusahaan lokal 
      ke panggung digital. Kami percaya bahwa teknologi harus mudah diakses dan memberikan dampak nyata.
    </p>
    
    <div class="grid grid-cols-1 md:grid-cols-2 gap-8 mt-12">
      <!-- Kotak Visi -->
      <div class="bg-blue-50 p-6 rounded-lg border border-blue-100">
        <h2 class="text-xl font-bold text-blue-800 mb-3">Visi Kami</h2>
        <p class="text-gray-700">Menjadi mitra teknologi paling terpercaya di Indonesia.</p>
      </div>
      
      <!-- Kotak Misi -->
      <div class="bg-gray-50 p-6 rounded-lg border border-gray-200">
        <h2 class="text-xl font-bold text-gray-800 mb-3">Misi Kami</h2>
        <ul class="list-disc list-inside text-gray-700 space-y-2">
          <li>Menyediakan solusi perangkat lunak berkualitas tinggi.</li>
          <li>Memberikan pelayanan yang transparan dan profesional.</li>
          <li>Membangun tim yang berintegritas dan inovatif.</li>
        </ul>
      </div>
    </div>
  </div>
</Layout>