---
import Layout from '../layouts/Layout.astro';
---

<Layout judulHalaman="Kontak - Nusantara Tech">
  <div class="max-w-xl mx-auto py-8">
    <h1 class="text-3xl font-bold text-gray-900 mb-6 text-center">Hubungi Kami</h1>
    <p class="text-gray-600 mb-8 text-center">Punya pertanyaan atau ingin bekerja sama? Kirimkan pesan Anda.</p>

    <!-- Form Kontak -->
    <form id="contact-form" class="space-y-5">
      <div>
        <label for="nama" class="block text-sm font-medium text-gray-700 mb-1">Nama Lengkap</label>
        <input type="text" id="nama" required class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all">
      </div>
      
      <div>
        <label for="email" class="block text-sm font-medium text-gray-700 mb-1">Email</label>
        <input type="email" id="email" required class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all">
      </div>
      
      <div>
        <label for="pesan" class="block text-sm font-medium text-gray-700 mb-1">Pesan</label>
        <textarea id="pesan" rows="4" required class="w-full px-4 py-2 border border-gray-300 rounded-lg focus:ring-2 focus:ring-blue-500 focus:border-blue-500 outline-none transition-all"></textarea>
      </div>

      <button type="submit" class="w-full bg-blue-600 text-white font-bold py-3 px-4 rounded-lg hover:bg-blue-700 transition-colors shadow-md">
        Kirim Pesan
      </button>
    </form>

    <!-- Pesan Sukses (Tersembunyi secara default) -->
    <div id="success-message" class="hidden mt-6 p-4 bg-green-100 border border-green-400 text-green-700 rounded-lg text-center font-medium">
      Terima kasih! Pesan Anda telah berhasil dikirim.
    </div>
  </div>
</Layout>

<script>
  const form = document.getElementById('contact-form')!;
  const successMessage = document.getElementById('success-message')!;

  form.addEventListener('submit', (e) => {
    e.preventDefault(); 
    
    form.classList.add('hidden');
    successMessage.classList.remove('hidden');
  });
</script>